# ==========================================
# FinSage AI - Environment Variables Template
# ==========================================

# ------------------------------------------
# Database Configuration
# ------------------------------------------
# FinSage supports both local SQLite (default) and Firebase Firestore.
# For local development, use SQLite:
DATABASE_URL="file:./dev.db"

# To force local SQLite even if Firebase credentials are set, set:
# USE_LOCAL_DB="true"

# ------------------------------------------
# Authentication & Security
# ------------------------------------------
# Secret key used for signing session JWT tokens.
# Change this to a secure random string in production.
JWT_SECRET="finsage-super-secret-jwt-token-local-development-key-32chars"

# Base URL of the application (used in email password reset links)
APP_URL="http://localhost:3000"

# ------------------------------------------
# AI Provider Configuration
# ------------------------------------------
# FinSage uses Groq by default for fast, free AI inferences (financial advice,
# spending analysis, budget suggestions, weekly report).
# Get a free API key at: https://console.groq.com
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# Optional: OpenAI Provider
# If you prefer OpenAI, set your OpenAI API key:
# OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-4o-mini"
# AI_PROVIDER="openai"

# ------------------------------------------
# Email Service (Password Reset)
# ------------------------------------------
# Option A: Resend (https://resend.com - 100 free emails/day)
# RESEND_API_KEY=""
# EMAIL_FROM="FinSage <onboarding@resend.dev>"

# Option B: SMTP / Gmail (Free, uses Gmail App Password)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-16-char-app-password"

# ------------------------------------------
# Firebase Firestore (Optional Cloud Database)
# ------------------------------------------
# Google OAuth 2.0 Sign-In (Recommended)
# ------------------------------------------
# Create an OAuth 2.0 Client ID at:
# https://console.cloud.google.com/apis/credentials
# Add your Web Client ID here to enable 1-click Google Sign-In:
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

# ------------------------------------------
# Firebase Firestore (Optional Cloud Database)
# ------------------------------------------
# Leave empty to run with local SQLite database.
# Fill these in if you want to connect to Firebase Firestore:
# FIREBASE_PROJECT_ID=""
# FIREBASE_CLIENT_EMAIL=""
# FIREBASE_PRIVATE_KEY=""

# ------------------------------------------
# Firebase Client (Alternative Google Sign-In)
# ------------------------------------------
# Optional alternative if using Firebase Auth instead of standard Google OAuth:
# NEXT_PUBLIC_FIREBASE_API_KEY=""
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
